{
  "name": "@digitalpromise/icons",
  "version": "3.4.1",
  "type": "module",
  "description": "Digital Promise brand icons, packaged into an icon font.",
  "scripts": {
    "build": "fantasticon && pnpm svgr dist/icons",
    "prebuild": "mkdir -p dist dist/icons && pnpm svg:reorient && pnpm svg:optimize",
    "svg:reorient": "reorient src/icons -o dist/icons",
    "svg:optimize": "svgo -f dist/icons",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Digital Promise",
  "exports": {
    ".": "./dist/index.ts",
    "./components": "./dist/components/index.ts",
    "./css": "./dist/index.css",
    "./woff": "./dist/index.woff",
    "./woff2": "./dist/index.woff2"
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "fantasticon": "^4.1.0",
    "svg-reorient": "^1.0.3",
    "svgo": "^4.0.1"
  }
}
